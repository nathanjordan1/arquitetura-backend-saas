# Aplicação
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Banco de Dados (PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=saas_db
DATABASE_USER=postgres
DATABASE_PASS=sua_senha_segura_aqui

# Cache (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379

# Autenticação JWT
JWT_SECRET=seu_jwt_secret_minimo_32_caracteres
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=seu_refresh_secret_minimo_32_caracteres
JWT_REFRESH_EXPIRES_IN=7d

# Inteligência Artificial (OpenAI)
OPENAI_API_KEY=sk-sua_chave_openai_aqui
OPENAI_MODEL=gpt-4o

# Integração WhatsApp (Evolution API)
WHATSAPP_API_URL=https://sua-evolution-api.com
WHATSAPP_API_KEY=sua_chave_aqui
WHATSAPP_INSTANCE_ID=seu_instance_id
